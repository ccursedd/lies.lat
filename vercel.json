{
  "rewrites": [
    {
      "source": "/fav/:path*",
      "destination": "/fav/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    },
    {
      "source": "/profile.html",
      "destination": "/profile.html"
    },
    {
      "source": "/:path*",
      "destination": "/profile.html"
    }
  ],
  "cleanUrls": true
}
